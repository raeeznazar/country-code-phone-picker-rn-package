{
  "name": "phone-code-picker",
  "version": "0.2.1",
  "author":"raeeznazar",
  "description": "A simple, customizable phone number input with a searchable country code picker for React Native.",
  "main": "lib/commonjs/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib",
    "outdated": "npm outdated",
    "audit": "npm audit --omit=dev",
    "release:check": "npm run typecheck && npm run build && npm run audit"
  },
  "keywords": [
    "react-native",
    "phone-input",
    "phone-number",
    "country-code-picker",
    "country-picker",
    "bottom-sheet",
    "expo"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@gorhom/bottom-sheet": ">=5.0.0",
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-gesture-handler": ">=2.16.1",
    "react-native-reanimated": ">=3.10.0",
    "react-native-safe-area-context": ">=4.10.0"
  },
  "devDependencies": {
    "@gorhom/bottom-sheet": "^5.2.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "react-native-gesture-handler": "^2.24.0",
    "react-native-reanimated": "^3.17.0",
    "react-native-safe-area-context": "^4.14.0",
    "typescript": "^5.4.0"
  }
}
